{
  "name": "restoretest-report",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Source for the online-restore perf-breakdown report (builds a single self-contained ../index.html).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "SMOKE=1 vitest run test/smoke.test.ts",
    "hover": "SMOKE=1 vitest run test/hover.test.ts"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "playwright": "^1.61.1",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vite-plugin-singlefile": "^2.0.0",
    "vitest": "^3.2.6"
  }
}
